---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const pageTitle = "Sobre mí";

const identity = {
	firstName: "Chava",
	country: "México",
	occupation: "estudiante de Desarrollo de Software en el CETI Colomos",
	hobbies: ["el gym", "la música", "armar proyectos con Arduino"],
};

const skills = ["C++", "C#", "Java", "Kotlin", "Python", "JavaScript", "Arduino", "Astro"];

const happy = true;
const finished = false;
const goal = 3;

const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<style define:vars={{ skillColor, fontWeight, textCase }}>
			h1 {
				color: purple;
				font-size: 4rem;
			}
			.skill {
				color: var(--skillColor);
				font-weight: var(--fontWeight);
				text-transform: var(--textCase);
			}
		</style>
	</head>
	<body>
		<Header />

		<h1>{pageTitle}</h1>
		<h2>... y mi nuevo sitio con Astro</h2>

		<p>Soy Salvador Camacho, pero todos me dicen Chava. Estudio en el CETI Colomos, grupo 8A1.</p>

		<p>Esta es la segunda página de mi sitio y la primera que construí yo mismo. Se irá actualizando conforme avance en el tutorial de Astro.</p>

		<p>Algunos datos sobre mí:</p>
		<ul>
			<li>Me llamo {identity.firstName}.</li>
			<li>Vivo en {identity.country} y soy {identity.occupation}.</li>
			{identity.hobbies.length >= 2 &&
				<li>Dos de mis pasatiempos son: {identity.hobbies[0]} y {identity.hobbies[1]}.</li>
			}
		</ul>

		<p>Mis habilidades son:</p>
		<ul>
			{skills.map((skill) => <li class="skill">{skill}</li>)}
		</ul>

		{happy && <p>¡Estoy feliz de estar aprendiendo Astro!</p>}

		{finished && <p>¡Terminé este tutorial!</p>}

		{goal === 3 ? <p>Mi meta es terminar en 3 días.</p> : <p>Mi meta no es de 3 días.</p>}
        <Footer />
	</body>
</html>